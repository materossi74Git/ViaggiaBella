{
  "entities": {
    "User": {
      "title": "User",
      "description": "Profilo utente operatore o amministratore della cooperativa",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["operatore", "amministratore"] },
        "status": { "type": "string", "enum": ["attivo", "revocato"] },
        "pinHash": { "type": "string", "maxLength": 128 },
        "pinSalt": { "type": "string", "maxLength": 64 },
        "quickUnlockEnabled": { "type": "boolean" },
        "failedPinAttempts": { "type": "number" },
        "lockUntil": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "displayName", "role", "status"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Elenco di riferimento per verifica dei privilegi di amministratore",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "grantedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["email"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Anagrafica di un mezzo aziendale della cooperativa",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "plate": { "type": "string", "maxLength": 32 },
        "brandModel": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["auto", "furgone", "pulmino", "speciale"] },
        "status": { "type": "string", "enum": ["attivo", "inattivo"] },
        "qrCodeId": { "type": "string", "maxLength": 128 },
        "nfcTagId": { "type": "string", "maxLength": 128 },
        "currentKm": { "type": "number" },
        "activeTripId": { "type": "string", "maxLength": 128, "description": "ID del viaggio in corso" },
        "activeDriverId": { "type": "string", "maxLength": 128, "description": "UID conducente attivo" },
        "activeDriverName": { "type": "string", "maxLength": 128, "description": "Nome conducente attivo" },
        "isOccupied": { "type": "boolean", "description": "Stato di occupazione del mezzo" },
        "insuranceExpiry": { "type": "string", "maxLength": 32, "description": "Data di scadenza assicurazione RCA (YYYY-MM-DD)" },
        "insuranceCompany": { "type": "string", "maxLength": 128, "description": "Compagnia assicurativa" },
        "inspectionExpiry": { "type": "string", "maxLength": 32, "description": "Data di scadenza revisione periodica (YYYY-MM-DD)" },
        "inspectionNotes": { "type": "string", "maxLength": 500, "description": "Note revisione o officina incaricata" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "plate", "type", "status", "qrCodeId"]
    },
    "VehicleUsage": {
      "title": "VehicleUsage",
      "description": "Registrazione dell'utilizzo di un mezzo aziendale",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "vehicleId": { "type": "string", "maxLength": 128 },
        "vehicleName": { "type": "string", "maxLength": 128 },
        "vehiclePlate": { "type": "string", "maxLength": 32 },
        "driverId": { "type": "string", "maxLength": 128 },
        "driverName": { "type": "string", "maxLength": 128 },
        "usageDate": { "type": "string", "maxLength": 32 },
        "startTime": { "type": "string", "maxLength": 32 },
        "endTime": { "type": "string", "maxLength": 32 },
        "destination": { "type": "string", "maxLength": 256 },
        "reason": { "type": "string", "maxLength": 128 },
        "startKm": { "type": "number" },
        "endKm": { "type": "number" },
        "distanceKm": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1500 },
        "status": { "type": "string", "enum": ["in_corso", "completato", "da_verificare"] },
        "mode": { "type": "string", "enum": ["manuale", "pulsanti"] },
        "startRealTimestamp": { "type": "string", "maxLength": 64 },
        "endRealTimestamp": { "type": "string", "maxLength": 64 },
        "firstSavedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "lastModifiedBy": { "type": "string", "maxLength": 128 },
        "lastModifiedByName": { "type": "string", "maxLength": 128 },
        "hasAnomalies": { "type": "boolean" },
        "anomalyNotes": { "type": "string", "maxLength": 1000 }
      },
      "required": [
        "id",
        "vehicleId",
        "vehicleName",
        "vehiclePlate",
        "driverId",
        "driverName",
        "usageDate",
        "startTime",
        "destination",
        "reason",
        "status",
        "mode"
      ]
    },
    "CorrectionRequest": {
      "title": "CorrectionRequest",
      "description": "Richiesta di correzione di una registrazione scaduta",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "usageId": { "type": "string", "maxLength": 128 },
        "driverId": { "type": "string", "maxLength": 128 },
        "driverName": { "type": "string", "maxLength": 128 },
        "vehicleName": { "type": "string", "maxLength": 128 },
        "requestDate": { "type": "string", "maxLength": 64 },
        "reason": { "type": "string", "maxLength": 500 },
        "desiredChanges": { "type": "string", "maxLength": 1500 },
        "status": { "type": "string", "enum": ["in_attesa", "approvata", "rifiutata"] },
        "adminId": { "type": "string", "maxLength": 128 },
        "adminName": { "type": "string", "maxLength": 128 },
        "decisionDate": { "type": "string", "maxLength": 64 },
        "adminNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "usageId", "driverId", "driverName", "reason", "desiredChanges", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Tracciamento immutabile di tutte le operazioni rilevanti",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "usageId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userRole": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "actionType": { "type": "string", "enum": ["creazione", "modifica_operatore", "completamento", "correzione_amministrativa", "annullamento"] },
        "summary": { "type": "string", "maxLength": 500 },
        "previousValues": { "type": "string", "maxLength": 4000 },
        "newValues": { "type": "string", "maxLength": 4000 },
        "adminAuthorizerId": { "type": "string", "maxLength": 128 },
        "adminAuthorizerName": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 1000 },
        "technicalInfo": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "userId", "userName", "timestamp", "actionType"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Parametri di configurazione dell'applicazione",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "maxLength": 128 },
        "autoLockMinutes": { "type": "number" },
        "maxEditWindowMinutes": { "type": "number" },
        "reasons": { "type": "string", "maxLength": 2000 }
      },
      "required": ["companyName", "autoLockMinutes", "maxEditWindowMinutes"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Profili degli utenti registrati e credenziali di sblocco rapido"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Documenti degli amministratori autorizzati"
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Anagrafica dei mezzi della flotta"
    },
    "/vehicleUsages/{usageId}": {
      "schema": { "$ref": "#/entities/VehicleUsage" },
      "description": "Registrazioni di utilizzo veicoli"
    },
    "/correctionRequests/{requestId}": {
      "schema": { "$ref": "#/entities/CorrectionRequest" },
      "description": "Richieste di correzione inviate dagli operatori"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit log immutabile di tutte le operazioni di scrittura e modifica"
    },
    "/appSettings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Configurazioni globali della cooperativa"
    }
  }
}
